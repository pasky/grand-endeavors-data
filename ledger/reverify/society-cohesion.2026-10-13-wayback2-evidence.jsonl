{"id": "2025-12-12-openai-microsoft-murder-suicide-lawsuit", "result": "verified", "evidence": [{"doc": 2, "quote": "Published on December 12, 2025, at 1:03 am (Paris), updated on December 12, 2025, at 7:56 am"}, {"doc": 3, "quote": "The heirs of an 83-year-old Connecticut woman are suing ChatGPT maker OpenAI and its business partner Microsoft for wrongful death, alleging that the artificial intelligence chatbot intensified her son's \"paranoid delusions\" and helped direct them at his mother before he killed her."}, {"doc": 3, "quote": "The lawsuit filed by Adams' estate on Thursday in California Superior Court in San Francisco alleges OpenAI \"designed and distributed a defective product that validated a user's paranoid delusions about his own mother.\""}], "fetched": [{"doc": 1, "url": "https://www.lemonde.fr/en/pixels/article/2025/12/12/open-ai-microsoft-face-lawsuit-over-chatgpt-s-alleged-role-in-a-murder-suicide_6748404_13.html", "status": 200, "ok": true, "chars": 12553, "fetched_at": "2026-10-12T22:02:58+00:00", "sha256": "05819b12837f4414a144c6be517605d4b48992492c6c83c720b46272e2534ccc"}, {"doc": 2, "url": "https://web.archive.org/web/20260108090031id_/https://www.lemonde.fr/en/pixels/article/2025/12/12/open-ai-microsoft-face-lawsuit-over-chatgpt-s-alleged-role-in-a-murder-suicide_6748404_13.html", "status": 200, "ok": true, "chars": 17454, "fetched_at": "2026-10-12T22:03:19+00:00", "sha256": "d353ce7dbd62083342fd25ca4942e5f219c0370492c1a4e72529be1cf3e787e6"}, {"doc": 3, "url": "https://web.archive.org/web/20251212050431id_/https://www.lemonde.fr/en/pixels/article/2025/12/12/open-ai-microsoft-face-lawsuit-over-chatgpt-s-alleged-role-in-a-murder-suicide_6748404_13.html", "status": 200, "ok": true, "chars": 17855, "fetched_at": "2026-10-12T22:03:26+00:00", "sha256": "3bfed876ec40c660dcafab3cdb425f963b14437db76284ec55436c1974de6d3b"}]}
{"id": "2025-12-29-china-taiwan-largest-exercise", "result": "corrected", "evidence": [{"doc": 2, "quote": "BEIJING/TAIPEI, Dec 29 (Reuters) - China launched its most extensive war games around Taiwan on Monday to showcase Beijing's ability to cut off the island from outside support in a conflict, as U.S. President Donald Trump downplayed the threat behind the drills."}, {"doc": 2, "quote": "The Eastern Theatre Command said it had deployed troops, warships, fighter jets and artillery for its \"Justice Mission 2025\" exercises to encircle the democratically governed island, conduct live fire and simulated strikes on land and sea targets, and drills to blockade Taiwan's main ports."}, {"doc": 2, "quote": "The live-firing exercises will continue on Tuesday across a record seven zones designated by China's Maritime Safety Administration, making the drills the largest to date by total coverage and in areas closer to Taiwan than previous exercises."}, {"doc": 2, "quote": "Map showing five zones around Taiwan marked by China for December 30 military drills, and past drill areas."}], "fetched": [{"doc": 1, "url": "https://www.reuters.com/world/china/chinas-military-conduct-live-fire-exercises-around-taiwan-tuesday-2025-12-28/", "status": 401, "ok": false, "chars": null, "fetched_at": "2026-10-12T22:03:26+00:00"}, {"doc": 2, "url": "https://web.archive.org/web/20251231001250id_/https://www.reuters.com/world/china/chinas-military-conduct-live-fire-exercises-around-taiwan-tuesday-2025-12-28/", "status": 200, "ok": true, "chars": 16475, "fetched_at": "2026-10-12T22:03:50+00:00", "sha256": "93f980cb10415156a3001ac730ee37ac113d064f23ee87bd945768ad73a2daea"}]}
