{"id": "2025-11-11-carbon-brief-china-flat-18-months", "result": "verified", "evidence": [{"doc": 1, "quote": "China’s CO2 emissions have now been flat or falling for 18 months, starting in March 2024. This trend continued in the third quarter of 2025, when emissions were unchanged year-on-year."}, {"doc": 1, "quote": "The rapid adoption of electric vehicles (EVs) saw CO2 emissions from transport fuel drop by 5% year-on-year, while there were also declines from cement and steel production."}, {"doc": 1, "quote": "META article:published_time: 2025-11-11T00:01:00+00:00"}], "fetched": [{"doc": 1, "url": "https://www.carbonbrief.org/analysis-chinas-co2-emissions-have-now-been-flat-or-falling-for-18-months/", "status": 200, "ok": true, "chars": 25392, "fetched_at": "2026-10-12T16:51:29+00:00", "sha256": "3caf9919cd52ae878e8fe2d1ab1668abaf196aa62c12654148c4799d62debf79"}, {"doc": 2, "url": "https://web.archive.org/web/20260101192233id_/https://www.carbonbrief.org/analysis-chinas-co2-emissions-have-now-been-flat-or-falling-for-18-months/", "status": 200, "ok": true, "chars": 32089, "fetched_at": "2026-10-12T16:52:06+00:00", "sha256": "b43eba361589d27bd1d5b0ffbfdfdb687da52e2a1344e6525cd9aaabb4a9d49b"}, {"doc": 3, "url": "https://web.archive.org/web/20251111234059id_/https://www.carbonbrief.org/analysis-chinas-co2-emissions-have-now-been-flat-or-falling-for-18-months/", "status": 200, "ok": true, "chars": 32016, "fetched_at": "2026-10-12T16:52:12+00:00", "sha256": "ccd00c993437567731e933f46632b7c0a01f6849a446037134fb01685d2e3fc2"}]}
